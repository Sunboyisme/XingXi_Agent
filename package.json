{
  "name": "bai-agent",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5186 --strictPort",
    "desktop:dev": "tauri dev",
    "desktop:preview": "tauri dev --config src-tauri/tauri.preview.conf.json",
    "backend:dev": "uv run --project backend uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8766",
    "build": "tsc -b && vite build",
    "backend:bundle": "pwsh -NoProfile -File scripts/build-backend.ps1",
    "release:windows": "pwsh -NoProfile -File scripts/build-installer.ps1",
    "test": "vitest run",
    "api:types": "uv run --project backend python scripts/export-openapi.py && openapi-typescript .local-data/openapi.json -o src/lib/api.generated.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.468.0",
    "lunar-typescript": "1.8.6",
    "radix-ui": "^1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.0.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
